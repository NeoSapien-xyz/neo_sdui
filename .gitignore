# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# Unanchored so they also cover packages/* in the workspace.
pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
build/
coverage/

# FVM Version Cache
.fvm/
# Flutter golden-test failure diffs (regenerated on mismatch); any package depth
**/test/golden/failures/

# figwire deliverables — CDN staging (wire JSON + exported assets); reviewed then uploaded, never committed.
# Each family's theme ledger is the exception: it is the source of record for the
# app's theme file and holds no assets or secrets.
deliverables/*
!deliverables/*/
deliverables/*/*
!deliverables/*/theme_ledger.json

# Remote Config: re-pulled live on every publish (tool/publish_guide.py), never a committed baseline
remoteconfig.template.json
firebase-debug.log
